 <script>
    document.addEventListener("DOMContentLoaded", function () {
        const buttons = document.querySelectorAll(".nav-link");
        const items = document.querySelectorAll(".food-menu-item");
        const sections = document.querySelectorAll(".subcategory-section");
        const searchInput = document.getElementById("searchInput");
        const superSubcategoryTitles = document.querySelectorAll(".super-subcategory-title");
    
        // Category Filtering
        buttons.forEach(button => {
            button.addEventListener("click", function () {
                const category = this.getAttribute("data-category");
    
                buttons.forEach(btn => btn.classList.remove("active"));
                this.classList.add("active");
    
                sections.forEach(section => section.style.display = "none");
    
                if (category === "all") {
                    sections.forEach(section => section.style.display = "block");
                } else {
                    sections.forEach(section => {
                        if (section.getAttribute("data-category") === category) {
                            section.style.display = "block";
                        }
                    });
                }
            });
        });
    
        // Search Functionality
        searchInput.addEventListener("input", function () {
            const query = searchInput.value.toLowerCase();
            let hasResults = false;
    
            items.forEach(item => {
                const title = item.querySelector("h6").textContent.toLowerCase();
                if (title.includes(query)) {
                    item.style.display = "block";
                    hasResults = true;
                } else {
                    item.style.display = "none";
                }
            });
    
            // Hide the super subcategory titles when searching
            superSubcategoryTitles.forEach(title => {
                title.style.display = query ? "none" : "block";
            });
    
            // Hide empty sections
            sections.forEach(section => {
                const visibleItems = section.querySelectorAll(".food-menu-item[style='display: block;']");
                section.style.display = visibleItems.length > 0 ? "block" : "none";
            });
        });
    });
    
 </script>

    
