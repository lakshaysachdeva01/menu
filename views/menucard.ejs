            <style>
                /* Custom Toggle Switch */
                .custom-switch {
                    position: relative;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    cursor: pointer;
                    padding: 10px;
                    border-radius: 10px;
                    background: #ffffff;
                    width: 70px;
                    justify-content: center;
                    border: 1px solid #ddd;
                }
                
                .custom-switch input {
                    display: none;
                }
                
                .custom-slider {
                    position: relative;
                    width: 40px;
                    height: 18px;
                    background: #ddd;
                    border-radius: 12px;
                    transition: 0.3s;
                    display: flex;
                    align-items: center;
                    padding: 2px;
                }
                
                /* Veg Image inside Toggle */
                .toggle-icon {
                    width: 25px;
                    height: 25px;
                    transition: 0.3s;
                    position: absolute;
                    left: -2px;
                }
                
                /* When checked */
                .custom-switch input:checked + .custom-slider {
                    background: #118016;
                }
                
                .custom-switch input:checked + .custom-slider .toggle-icon {
                    transform: translateX(20px);
                }
                
                /* Popup Styles */
                .popup-overlay {
                    display: none;
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    z-index: 1001;
                    background: rgba(0, 0, 0, 0.5);
                    justify-content: center;
                    align-items: center;
                }
                
                .popup-content {
                    background: #fff;
                    padding: 20px;
                    border-radius: 8px;
                    text-align: left;
                    width: 300px;
                }
                
                .popup-option {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    margin-bottom: 10px;
                    font-size: 16px;
                }
                
                #applyFilter {
                    width: 100%;
                    padding: 10px;
                    background: #118016;
                    color: white;
                    border: none;
                    cursor: pointer;
                    border-radius: 5px;
                }
                </style>
            <!-- Toggle Switch -->

