<!-- Popup Modal -->
<div id="menuFilterPopup" class="popup-overlay">
    <div class="popup-content">
        <h3>I want to see  </h3>
        <label class="popup-option">
            <input type="radio" name="menuFilter" value="all" checked> All Dishes
        </label>
        <label class="popup-option">
            <input type="radio" name="menuFilter" value="veg"> Pure veg Dishes only
        </label>
        <button id="applyFilter">Show results</button>
    </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", function () {
    const menuToggle = document.getElementById("menuToggle");
    const menuFilterPopup = document.getElementById("menuFilterPopup");
    const applyFilter = document.getElementById("applyFilter");
    const filterOptions = document.querySelectorAll("input[name='menuFilter']");
    
    let selectedFilter = localStorage.getItem("selectedFilter") || "all";
    
    if (selectedFilter === "veg") {
        menuToggle.checked = true;
        filterVegDishes();
    } else {
        menuToggle.checked = false;
        showAllDishes();
    }
    
    menuToggle.addEventListener("change", function (event) {
        if (!menuToggle.checked) {
            showAllDishes();
            localStorage.setItem("selectedFilter", "all");
        } else {
            menuFilterPopup.style.display = "flex";
            event.preventDefault();
            setTimeout(() => (menuToggle.checked = selectedFilter === "veg"), 0);
        }
    });
    
    applyFilter.addEventListener("click", function () {
        let selectedOption = document.querySelector("input[name='menuFilter']:checked").value;
        
        if (selectedOption === "veg") {
            filterVegDishes();
            localStorage.setItem("selectedFilter", "veg");
            menuToggle.checked = true;
        } else {
            showAllDishes();
            localStorage.setItem("selectedFilter", "all");
            menuToggle.checked = false;
        }
        
        menuFilterPopup.style.display = "none";
    });
    
    function showAllDishes() {
        document.querySelectorAll(".food-menu-item").forEach(item => {
            item.style.display = "block";
        });
        updateSuperSubVisibility();
    }
    
    function filterVegDishes() {
        document.querySelectorAll(".food-menu-item").forEach(item => {
            let featureType = item.getAttribute("data-featureType");
            if (featureType === "666a87cda9d9239927d47193") {
                item.style.display = "block";
            } else {
                item.style.display = "none";
            }
        });
        updateSuperSubVisibility();
    }
    
    function updateSuperSubVisibility() {
        document.querySelectorAll(".super-subcategory-section").forEach(section => {
            let visibleItems = section.querySelectorAll(".food-menu-item:not([style*='display: none'])");
            section.style.display = visibleItems.length === 0 ? "none" : "block";
        });
    }
});
</script>



