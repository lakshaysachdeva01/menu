                    // Smooth scroll to top when search is focused
                    searchInput.addEventListener("focus", function () {
                        setTimeout(() => {
                            stickySection.scrollIntoView({ behavior: "smooth", block: "start" });
                        }, 200); // Small delay to ensure focus event works smoothly
                    });
